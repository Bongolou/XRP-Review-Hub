# PostgreSQL connection string used by the server and Drizzle.
# Configure on the Node backend, not Bluehost. Replit manages this value.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Node environment. Use "production" on the live server.
NODE_ENV=production

# Port the Express server listens on.
PORT=5000

# Welcome emails: connect Resend in Replit Integrations and use an address
# on a verified sending domain. A direct Resend API key is also supported
# through Replit Secrets; never put it in the static build or PHP relay.
WELCOME_EMAIL_FROM=All Things XRPL <newsletter@allthingsxrpl.com>
PUBLIC_BASE_URL=https://allthingsxrpl.com

# Only the GitHub Bluehost build sets this. The Node build leaves it unset.
# BLUEHOST_DEPLOY=1
