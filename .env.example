# PostgreSQL connection string used by the server and Drizzle.
# On Bluehost, create a database in cPanel and paste the full URL here.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Node environment. Use "production" on the live server.
NODE_ENV=production

# Port the Express server listens on. Bluehost typically assigns this
# automatically — only set it explicitly if your host requires it.
PORT=5000
